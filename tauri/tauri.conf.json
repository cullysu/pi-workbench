{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Workbench",
  "version": "0.4.2",
  "identifier": "com.cullysu.piworkbench",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../pkg-runtime.zip": "pkg-runtime.zip"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
